{
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "cypress/unsafe-to-chain-command": "off",
  "env": {
    "browser": true,
    "es6": true,
    "cypress/globals": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:cypress/recommended"
  ],
  "plugins": [
    "cypress"
  ]
}